# ---- Copy this file to ".env" and fill in real values ----
#   cp .env.example .env

# How the stack reaches sFlow-RT.
# Running on the SAME server as sFlow-RT, the public proxied URL works fine.
SFLOWRT_URL=https://noc.bharatdatacenter.com/sflow
SFLOWRT_USER=admin
SFLOWRT_PASS=change-me

# Set to "1" only if sFlow-RT is behind a self-signed TLS cert.
SFLOWRT_INSECURE=0

# Which logged flows to capture for forensics. Empty = ALL log:true flows.
# Example: FLOW_NAMES=ixp_flood_local,ixp_badprotocol,ixp_bgp
FLOW_NAMES=

# How long to keep flow records in OpenSearch (days). Keep in step with
# Prometheus --storage.tsdb.retention.time in docker-compose.yml.
RETENTION_DAYS=30

# ---- Dashboard login ----
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# Signs session cookies. setup-vm.sh fills this in; changing it logs everyone out.
AUTH_SECRET=

# Public address the browser uses: the VM's IP (self-signed HTTPS) or a DNS
# name pointing at the VM (trusted Let's Encrypt HTTPS).
SITE_ADDRESS=157.10.98.155
# "tls internal" for an IP; "tls you@example.com" for a DNS name (Let's Encrypt).
SITE_TLS=tls internal

# Internal URLs used by webapp container to reach sibling containers.
PROM_URL=http://prometheus:9090
OPENSEARCH_URL=http://opensearch:9200
NEXT_PUBLIC_BASE_PATH=/dashboard
